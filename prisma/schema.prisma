generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum OrganizationRole {
  OWNER
  ADMIN
  PROCUREMENT_USER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// -----------------------------------------------------------------------------
// BETTER AUTH CORE MODELS (Strict Better Auth schema conventions)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  
  // Arbiter relations
  memberships   OrganizationMember[]
  souringEvents SourcingEvent[]
  auditLogs AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// -----------------------------------------------------------------------------
// BIDFLOW BUYER MODELS (Multi-tenancy & Procurement Master Data)
// -----------------------------------------------------------------------------

enum OrganizationType {
  BUYER
  SUPPLIER
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  countryCode String?  // e.g., "US", "ID", "SG"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  events      SourcingEvent[]
  suppliers   Supplier[]           // Master directory of suppliers owned by this buyer
  type        OrganizationType @default(BUYER) // 👈 Add this line
}

model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// Buyer's private supplier directory (Master Data)
model Supplier {
  id             String   @id @default(cuid())
  organizationId String

  legalName      String
  countryCode    String?
  website        String?

  contactName    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?

  isArchived     Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventSuppliers EventSupplier[]
  sessions       SupplierEventSession[]
  supplierInvitations EventSupplierInvitation[]

  @@index([organizationId])
  @@index([organizationId, legalName])
}

enum SourcingEventStatus {
  DRAFT
  SCHEDULED
  INVITATION_PENDING
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

model SourcingEvent {
  id             String              @id @default(cuid())
  organizationId String

  title          String
  description    String?
  referenceCode  String?

  status         SourcingEventStatus @default(DRAFT)

  currency       String
  timezone       String

  startsAt       DateTime?
  endsAt         DateTime?

  createdById    String

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])

  lots           SourcingLot[]
  eventInvitations EventSupplierInvitation[]
  eventSessions  SupplierEventSession[]
  eventSuppliers EventSupplier[]
  quotations Quotation[]
  auditLogs AuditLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([createdById])
}

model SourcingLot {
  id          String   @id @default(cuid())
  eventId     String

  name        String
  description String?
  order       Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       SourcingEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  items       SourcingItem[]

  @@index([eventId])
}

model SourcingItem {
  id            String   @id @default(cuid())
  lotId         String

  name          String
  description   String?

  quantity      Decimal
  unit          String
  specification String?
  referencePrice Decimal?

  order         Int

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lot           SourcingLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  quotationLines QuotationLine[]

  @@index([lotId])
}

// -----------------------------------------------------------------------------
// SUPPLIER EVENT ACCESS MODELS (Capability-based auth)
// -----------------------------------------------------------------------------

enum EventSupplierStatus {
  SELECTED
  INVITED
  ACCEPTED
  DECLINED
  REVOKED
}

model EventSupplier {
  id         String              @id @default(cuid())
  eventId    String
  supplierId String

  status     EventSupplierStatus @default(SELECTED)

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  event      SourcingEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invitation EventSupplierInvitation?
  quotations Quotation[]

  @@unique([eventId, supplierId])
  @@index([eventId])
  @@index([supplierId])
}

model EventSupplierInvitation {
  id              String           @id @default(cuid())
  eventSupplierId String   @unique
  eventId         String
  supplierId      String?          // Links back to buyer's Supplier directory record

  companyName     String
  contactName     String?
  email           String

  tokenHash       String           @unique // Cryptographic hash of the URL token

  status          InvitationStatus @default(PENDING)

  expiresAt       DateTime
  revokedAt       DateTime?
  firstAccessedAt DateTime?
  lastAccessedAt  DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  event           SourcingEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  eventSupplier   EventSupplier @relation(fields: [eventSupplierId], references: [id], onDelete: Cascade)
  sessions        SupplierEventSession[]
  quotations Quotation[]

  @@index([eventId])
  @@index([supplierId])
  @@index([email])
}

model SupplierEventSession {
  id             String   @id @default(cuid())
  invitationId   String
  eventId        String
  supplierId     String?

  sessionHash    String   @unique // Hash of the opaque session cookie

  expiresAt      DateTime
  revokedAt      DateTime?

  createdAt      DateTime @default(now())
  lastActiveAt   DateTime?

  invitation     EventSupplierInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  event          SourcingEvent           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  supplier       Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quotations Quotation[]

  @@index([invitationId])
  @@index([eventId])
  @@index([supplierId])
}

// ─── New models ───────────────────────────────────────────────────────────────

enum QuotationStatus {
  SUBMITTED
}

/// One row = one immutable submitted revision. "Latest" = highest revisionNumber.
/// Never UPDATE or DELETE these rows from application code.
model Quotation {
  id              String          @id @default(cuid())
  eventId         String
  eventSupplierId String
  revisionNumber  Int
  status          QuotationStatus @default(SUBMITTED)

  currency      String
  totalAmount   Decimal   @db.Decimal(18, 4) // computed server-side from lines
  leadTimeDays  Int?
  validUntil    DateTime?
  deliveryTerms String?
  paymentTerms  String?
  notes         String?

  submittedAt DateTime @default(now())

  // Supplier-side actor: nullable; SetNull so session cleanup never deletes history.
  submittedBySessionId    String?
  submittedByInvitationId String?

  event         SourcingEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventSupplier EventSupplier            @relation(fields: [eventSupplierId], references: [id], onDelete: Cascade)
  session       SupplierEventSession?    @relation(fields: [submittedBySessionId], references: [id], onDelete: SetNull)
  invitation    EventSupplierInvitation? @relation(fields: [submittedByInvitationId], references: [id], onDelete: SetNull)

  lines QuotationLine[]

  // Backstop: even if locking fails, duplicate revision numbers are impossible.
  @@unique([eventSupplierId, revisionNumber])
  @@index([eventId, eventSupplierId])
  @@index([submittedBySessionId])
  @@index([submittedByInvitationId])
}

model QuotationLine {
  id          String @id @default(cuid())
  quotationId String
  itemId      String

  unit              String  // snapshot of requested unit
  requestedQuantity Decimal @db.Decimal(18, 4) // snapshot
  quotedQuantity    Decimal @db.Decimal(18, 4)
  unitPrice         Decimal @db.Decimal(18, 4)
  lineTotal         Decimal @db.Decimal(18, 4)
  leadTimeDays      Int?
  notes             String?

  quotation Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      SourcingItem @relation(fields: [itemId], references: [id], onDelete: NoAction)

  @@unique([quotationId, itemId])
  @@index([itemId])
}

enum AuditActorType {
  SUPPLIER // invitation/session based, no User
  BUYER    // authenticated User
  SYSTEM
}

// T_TRACK
model AuditLog {
  id          String         @id @default(cuid())
  eventId     String
  action      String         // e.g. "QUOTATION_SUBMITTED"
  actorType   AuditActorType
  actorUserId String?        // set for BUYER actions only
  metadata    Json?
  createdAt   DateTime       @default(now())

  event     SourcingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorUser User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([action])
  @@index([actorUserId])
}